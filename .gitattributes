# 统一换行符为 LF：GitHub Actions 的构建跑在 Linux 上，
# 这样本地（Windows）编辑和 CI 构建不会产生无意义的行尾差异
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 这些文件保持 LF（GitHub Actions 在 Linux 上读取）
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf