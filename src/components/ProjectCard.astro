---
/**
 * 研究方向卡片：左侧是配图，右侧是方向说明。
 *
 * 配图是**自绘的矢量网络图**（由 _tools/build-research-diagrams.mjs 生成成 SVG），
 * 不是论文里的 framework 图 —— 按实验室要求换掉了：论文插图是为具体方法服务的，
 * 缩到卡片宽度后小字全糊，而且跟方向本身对不上。
 *
 * 用 SVG 的好处是矢量，点开放大不会糊；卡片宽度下文字仍偏小，
 * 所以**图片整块做成链接，点开看原图**（见 .project-card__zoom）。
 * 图是自己画的，不涉及第三方版权，因此卡片底部不再需要论文出处那一行。
 */
import { ui, t, type Lang } from '../i18n/ui';
import type { ResearchTopic } from '../data/research';

interface Props {
  topic: ResearchTopic;
  lang: Lang;
}

const { topic, lang } = Astro.props;
const title = topic.title[lang];
const zoomLabel = t(ui.research.viewFull, lang);
---

<article class="project-card" id={topic.id}>
  {topic.image && (
    <a
      class="project-card__media"
      href={topic.image}
      target="_blank"
      rel="noopener noreferrer"
      title={zoomLabel}
      aria-label={`${zoomLabel}: ${title}`}
    >
      <img
        src={topic.image}
        alt={`${title} —— ${lang === 'zh' ? '研究方向示意图' : 'schematic diagram'}`}
        loading="lazy"
        decoding="async"
      />
      <span class="project-card__zoom" aria-hidden="true">
        <i class="bi bi-arrows-fullscreen"></i>
        <span>{zoomLabel}</span>
      </span>
    </a>
  )}

  <div class="project-card__body">
    <div class="project-card__head">
      <h3 class="project-card__title">{title}</h3>
      <span class="btn-square" aria-hidden="true">
        <i class={`bi ${topic.icon}`}></i>
      </span>
    </div>

    <p class="project-card__summary">{topic.summary[lang]}</p>

    <ul class="project-card__points">
      {topic.points.map((point) => (
        <li>{point[lang]}</li>
      ))}
    </ul>
  </div>
</article>