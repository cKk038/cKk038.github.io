---
/**
 * 右下角「回到顶部」按钮。
 * 默认隐藏，页面滚动超过一屏后由 JS 加上 .is-visible 淡入。
 */
import { ui, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const label = t(ui.common.backToTop, lang);
---

<button class="back-to-top" id="backToTop" type="button" aria-label={label} title={label}>
  <i class="bi bi-arrow-up" aria-hidden="true"></i>
</button>